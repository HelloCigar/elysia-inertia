{
  "compilerOptions": {
    "target": "ESNext",
    "module": "ESNext",
    "moduleResolution": "bundler",
    "strict": true,
    "skipLibCheck": true,
    "noEmit": true,
    "types": [
      "bun"
    ],
    "jsx": "react-jsx",
    "lib": [
      "ESNext",
      "DOM"
    ],
    "paths": {
      "elysia-inertia": [
        "./src/index.ts"
      ],
      "elysia-inertia/client": [
        "./src/client.ts"
      ],
      "elysia-inertia/internal": [
        "./src/internal.ts"
      ],
      "elysia-inertia/vite": [
        "./src/vite-entry.ts"
      ]
    }
  },
  "include": [
    "src",
    "test"
  ],
  "exclude": [
    "test/register",
    "test/pages-types",
    "test/routes-types",
    "test/package"
  ]
}
