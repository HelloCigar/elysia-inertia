{
  "name": "elysia-inertia",
  "version": "0.2.0",
  "description": "Inertia.js v3 server adapter for Elysia 2",
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./client": {
      "types": "./dist/client.d.ts",
      "import": "./dist/client.js"
    },
    "./internal": {
      "types": "./dist/internal.d.ts",
      "import": "./dist/internal.js"
    },
    "./vite": {
      "types": "./dist/vite-entry.d.ts",
      "import": "./dist/vite-entry.js"
    }
  },
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "test": "bun test",
    "typecheck": "tsc -p . && tsc -p test/register && tsc -p test/pages-types && tsc -p test/routes-types",
    "check:package": "bun run build && tsc -p test/package && bun run scripts/check-package.ts",
    "prepack": "bun run build",
    "prepublishOnly": "bun run typecheck && bun test && bun run check:package"
  },
  "peerDependencies": {
    "elysia": ">=2.0.0-rc.0"
  },
  "devDependencies": {
    "@inertiajs/core": "3.9.1",
    "@inertiajs/react": "3.9.1",
    "@types/bun": "^1.4.3",
    "@types/node": "^26.6.5",
    "@types/react": "^19.3.0",
    "elysia": "2.0.0-rc.0",
    "react": "^19.3.1",
    "typescript": "^7.0.2"
  },
  "files": [
    "dist"
  ]
}
